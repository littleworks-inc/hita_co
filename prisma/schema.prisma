// ✅ Complete prisma/schema.prisma with Exhibition POS System + Flexible Size System
// Enhanced schema with Shipping System + Return Policy + Exhibition POS + Size Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id                    String     @id @default(cuid())
  name                  String     @unique
  description           String?
  slug                  String     @unique
  parentId              String?
  
  // ✅ SIMPLIFIED: Remove defaultSizeType field
  defaultRequiresSizes  Boolean    @default(false)  // Keep this
  // defaultSizeType    String?                     // ✅ REMOVE THIS LINE
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  parent                Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children              Category[] @relation("CategoryHierarchy")
  products              Product[]

  @@map("categories")
}

model Country {
  id             String    @id @default(cuid())
  name           String    @unique
  code           String    @unique
  currency       String
  currencySymbol String
  exchangeRate   Float?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
  countryZones   CountryShippingZone[]

  @@map("countries")
}

model Supplier {
  id            String    @id @default(cuid())
  name          String    @unique
  contactPerson String?
  email         String?
  phone         String?
  whatsapp      String?
  address       String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  businessType  String?
  gstNumber     String?
  panNumber     String?
  bankName      String?
  accountNumber String?
  ifscCode      String?
  notes         String?
  rating        Float?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@map("suppliers")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderSource {
  ONLINE
  EXHIBITION
  MANUAL
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// ✅ Exhibition Payment Methods
enum ExhibitionPaymentMethod {
  CASH
  ZELLE
  CARD
  VENMO
  PAYPAL
  SPLIT_PAYMENT
}

model Product {
  id                      String              @id @default(cuid())
  sku                     String              @unique
  name                    String
  description             String?
  shortDescription        String?
  images                  String[]
  categoryId              String
  countryId               String
  originalPrice           Float
  originalCurrency        String
  supplierId              String
  purchaseDate            DateTime?
  invoiceNumber           String?
  quantity                Int                 @default(1)
  gstPercentage           Float               @default(0)
  shippingCost            Float               @default(0)
  conversionCharges       Float               @default(0)
  additionalExpenses      Float               @default(0)
  costPriceUSD            Float
  piecePriceUSD           Float
  profitMargin            Float               @default(0)
  discountPercentage      Float               @default(0)
  sellingPriceUSD         Float
  stockQuantity           Int                 @default(0)
  lowStockAlert           Int                 @default(5)
  seoTitle                String?
  seoDescription          String?
  tags                    String[]
  isActive                Boolean             @default(true)
  isFeatured              Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  barcode                 String?             @unique
  barcodeType             String?             @default("CODE128")
  publishedAt             DateTime?
  status                  ProductStatus       @default(DRAFT)
  archivedAt              DateTime?
  showDiscountToCustomers Boolean             @default(false)
  
  // ✅ SIMPLIFIED: Size system fields - remove sizeType
  requiresSizes           Boolean             @default(false)  // Keep this
  // sizeType             SizeType?                           // ✅ REMOVE THIS LINE
  
  // Relations
  exhibitionItems         ExhibitionProduct[]
  orderItems              OrderItem[]
  exhibitionSaleItems     ExhibitionSaleItem[]
  productSizes            ProductSize[]       
  cartItems               CartItem[]          
  category                Category            @relation(fields: [categoryId], references: [id])
  country                 Country             @relation(fields: [countryId], references: [id])
  supplier                Supplier            @relation(fields: [supplierId], references: [id])

  @@map("products")
}

// ✅ NEW: Product Size Variants Model
model ProductSize {
  id                    String                 @id @default(cuid())
  productId             String
  size                  String                 // "XS", "S", "M", "L", "XL", "XXL", "6", "7", "8", etc.
  sku                   String                 @unique // "KURTA-001-S", "KURTA-001-M"
  stockQuantity         Int                    @default(0)
  lowStockAlert         Int                    @default(5)
  isActive              Boolean                @default(true)
  sortOrder             Int                    @default(0)  // For custom size ordering
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  
  // Relations
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  exhibitionSizes       ExhibitionProductSize[]
  orderItems            OrderItem[]
  cartItems             CartItem[]
  exhibitionSaleItems   ExhibitionSaleItem[]   // ✅ NEW: Exhibition sale items

  @@map("product_sizes")
}

// ✅ NEW: Exhibition Size Tracking
model ExhibitionProductSize {
  id                    String              @id @default(cuid())
  exhibitionProductId   String
  productSizeId         String
  quantityTaken         Int                 @default(0)  // How many of this size taken to exhibition
  quantitySold          Int                 @default(0)  // How many sold at exhibition
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Relations
  exhibitionProduct     ExhibitionProduct   @relation(fields: [exhibitionProductId], references: [id], onDelete: Cascade)
  productSize           ProductSize         @relation(fields: [productSizeId], references: [id], onDelete: Cascade)

  @@unique([exhibitionProductId, productSizeId])
  @@map("exhibition_product_sizes")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress Json
  subtotal        Float
  tax             Float         @default(0)
  shipping        Float         @default(0)
  discount        Float         @default(0)
  total           Float
  currency        String        @default("USD")
  source          OrderSource   @default(ONLINE)
  locationNote    String?
  exhibitionId    String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  exhibition      Exhibition?   @relation(fields: [exhibitionId], references: [id])

  @@map("orders")
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  productId      String
  productSizeId  String?      // ✅ NEW: Optional size reference
  sizeLabel      String?      // ✅ NEW: Size display text ("Medium", "Large")
  quantity       Int
  pricePerItem   Float
  totalPrice     Float
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
  productSize    ProductSize? @relation(fields: [productSizeId], references: [id])

  @@map("order_items")
}

// ✅ NEW: Cart Item Model (for persistent cart)
model CartItem {
  id             String       @id @default(cuid())
  sessionId      String       // For guest users
  userId         String?      // For logged-in users (future)
  productId      String
  productSizeId  String?      // ✅ NEW: Optional size reference
  quantity       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  // Relations
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSize    ProductSize? @relation(fields: [productSizeId], references: [id])

  @@unique([sessionId, productId, productSizeId])
  @@map("cart_items")
}

model Exhibition {
  id               String              @id @default(cuid())
  title            String
  description      String?
  location         String
  startDate        DateTime
  endDate          DateTime
  participationFee Float               @default(0)
  images           String[]
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  
  // Relations
  products         ExhibitionProduct[]
  orders           Order[]
  sales            ExhibitionSale[]

  @@map("exhibitions")
}

model ExhibitionProduct {
  id            String     @id @default(cuid())
  exhibitionId  String
  productId     String
  quantityTaken Int
  quantitySold  Int        @default(0)
  
  // Exhibition-specific pricing fields
  exhibitionPrice     Float?    // Override price for this exhibition
  originalPrice       Float?    // Store the original price for reference
  discountPercentage  Float?    @default(0) // Clearance discount
  isClearance         Boolean   @default(false) // Mark as clearance item
  priceHistory        Json?     // Track price changes during exhibition
  
  // Sales tracking fields
  salesNotes          String?   // Notes about sales performance
  lastSaleDate        DateTime? // When was last item sold
  priceChangedAt      DateTime? // When price was last updated
  
  // Relations
  exhibition    Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id])
  saleItems     ExhibitionSaleItem[]
  exhibitionSizes ExhibitionProductSize[]  // ✅ NEW: Size tracking

  @@unique([exhibitionId, productId])
  @@map("exhibition_products")
}

// Exhibition Sales (POS System)
model ExhibitionSale {
  id                    String                    @id @default(cuid())
  exhibitionId          String
  saleNumber            String                    @unique // EXH001, EXH002, etc.
  
  // Customer Info
  customerName          String?
  customerPhone         String?
  customerEmail         String?
  
  // Sale Details
  subtotal              Float
  tax                   Float                     @default(0)
  discount              Float                     @default(0)
  total                 Float
  
  // Payment Info
  paymentMethod         ExhibitionPaymentMethod
  paymentDetails        Json?                     // For split payments, references, etc.
  cashReceived          Float?                    // For cash transactions
  changeGiven           Float?                    // For cash transactions
  
  // Status & Tracking
  isCompleted           Boolean                   @default(false)
  completedAt           DateTime?
  receiptPrinted        Boolean                   @default(false)
  receiptEmailSent      Boolean                   @default(false)
  staffNotes            String?
  
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  
  // Relations
  exhibition            Exhibition                @relation(fields: [exhibitionId], references: [id])
  items                 ExhibitionSaleItem[]

  @@map("exhibition_sales")
}

// Individual items within an exhibition sale
model ExhibitionSaleItem {
  id                    String            @id @default(cuid())
  saleId                String
  exhibitionProductId   String
  productId             String
  productSizeId         String?           // ✅ NEW: Size reference
  sizeLabel             String?           // ✅ NEW: Size display
  
  // Pricing (at time of sale)
  originalPrice         Float             // Product's original price
  exhibitionPrice       Float             // Exhibition price (if different)
  discountApplied       Float             @default(0) // Individual item discount
  finalPrice            Float             // What was actually charged
  
  quantity              Int               @default(1)
  lineTotal             Float             // finalPrice * quantity
  
  // Metadata
  wasScanned            Boolean           @default(false) // Was barcode scanned?
  scanMethod            String?           // "BARCODE" or "SKU" or "MANUAL"
  appliedDiscount       Float             @default(0)     // Individual item discount
  
  createdAt             DateTime          @default(now())
  
  // Relations
  sale                  ExhibitionSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  exhibitionProduct     ExhibitionProduct @relation(fields: [exhibitionProductId], references: [id])
  product               Product           @relation(fields: [productId], references: [id])
  productSize           ProductSize?      @relation(fields: [productSizeId], references: [id])
  
  @@map("exhibition_sale_items")
}

model StoreSetting {
  id                        String        @id @default(cuid())
  storeName                 String        @default("LittleWorks Inc")
  tagline                   String?
  logo                      String?
  favicon                   String?
  primaryColor              String        @default("#000000")
  secondaryColor            String        @default("#ffffff")
  accentColor               String        @default("#f59e0b")
  email                     String?
  phone                     String?
  address                   Json?
  instagram                 String?
  facebook                  String?
  pinterest                 String?
  twitter                   String?
  aiProvider                String?
  aiApiKey                  String?
  aiModel                   String?
  currency                  String        @default("USD")
  timezone                  String        @default("America/New_York")
  defaultShippingZoneId     String?
  
  // Return Policy Fields with No Returns Option
  returnsEnabled            Boolean?      @default(true)
  returnPeriodDays          Int?          @default(30)
  returnPolicyUrl           String?
  hasRestockingFee          Boolean?      @default(false)
  restockingFeePercentage   Float?        @default(0)
  returnPolicyDescription   String?
  noReturnsReason           String?
  
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  defaultShippingZone       ShippingZone? @relation(fields: [defaultShippingZoneId], references: [id])

  @@map("store_settings")
}

// Shipping Zone Model (groups countries/regions)
model ShippingZone {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  isDefault       Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  zoneCountries   CountryShippingZone[]
  shippingRates   ShippingRate[]
  storeSettings   StoreSetting[]

  @@map("shipping_zones")
}

model CountryShippingZone {
  id              String       @id @default(cuid())
  countryId       String
  shippingZoneId  String
  createdAt       DateTime     @default(now())
  country         Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  shippingZone    ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@unique([countryId, shippingZoneId])
  @@map("country_shipping_zones")
}

// Shipping Rate Model (pricing rules per zone)
model ShippingRate {
  id                    String       @id @default(cuid())
  shippingZoneId        String
  name                  String
  description           String?
  flatRate              Float
  freeShippingThreshold Float?
  estimatedDays         String?
  maxWeightKg           Float?
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  shippingZone          ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@map("shipping_rates")
}