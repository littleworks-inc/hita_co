// ✅ UPDATED: prisma/schema.prisma - Added Return Policy Fields to StoreSetting

// Enhanced prisma/schema.prisma with Shipping System + Return Policy
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  slug        String     @unique
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Country {
  id             String    @id @default(cuid())
  name           String    @unique
  code           String    @unique
  currency       String
  currencySymbol String
  exchangeRate   Float?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
  countryZones   CountryShippingZone[]

  @@map("countries")
}

model Supplier {
  id            String    @id @default(cuid())
  name          String    @unique
  contactPerson String?
  email         String?
  phone         String?
  whatsapp      String?
  address       String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  businessType  String?
  gstNumber     String?
  panNumber     String?
  bankName      String?
  accountNumber String?
  ifscCode      String?
  notes         String?
  rating        Float?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@map("suppliers")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderSource {
  ONLINE
  EXHIBITION
  MANUAL
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Product {
  id                      String              @id @default(cuid())
  sku                     String              @unique
  name                    String
  description             String?
  shortDescription        String?
  images                  String[]
  categoryId              String
  countryId               String
  originalPrice           Float
  originalCurrency        String
  supplierId              String
  purchaseDate            DateTime?
  invoiceNumber           String?
  quantity                Int                 @default(1)
  gstPercentage           Float               @default(0)
  shippingCost            Float               @default(0)
  conversionCharges       Float               @default(0)
  additionalExpenses      Float               @default(0)
  costPriceUSD            Float
  piecePriceUSD           Float
  profitMargin            Float               @default(0)
  discountPercentage      Float               @default(0)
  sellingPriceUSD         Float
  stockQuantity           Int                 @default(0)
  lowStockAlert           Int                 @default(5)
  seoTitle                String?
  seoDescription          String?
  tags                    String[]
  isActive                Boolean             @default(true)
  isFeatured              Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  barcode                 String?             @unique
  barcodeType             String?             @default("CODE128")
  publishedAt             DateTime?
  status                  ProductStatus       @default(DRAFT)
  archivedAt              DateTime?
  showDiscountToCustomers Boolean             @default(false)
  exhibitionItems         ExhibitionProduct[]
  orderItems              OrderItem[]
  category                Category            @relation(fields: [categoryId], references: [id])
  country                 Country             @relation(fields: [countryId], references: [id])
  supplier                Supplier            @relation(fields: [supplierId], references: [id])

  @@map("products")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress Json
  subtotal        Float
  tax             Float         @default(0)
  shipping        Float         @default(0)
  discount        Float         @default(0)
  total           Float
  currency        String        @default("USD")
  source          OrderSource   @default(ONLINE)
  locationNote    String?
  exhibitionId    String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  exhibition      Exhibition?   @relation(fields: [exhibitionId], references: [id])

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  pricePerItem Float
  totalPrice   Float
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Exhibition {
  id               String              @id @default(cuid())
  title            String
  description      String?
  location         String
  startDate        DateTime
  endDate          DateTime
  participationFee Float               @default(0)
  images           String[]
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  products         ExhibitionProduct[]
  orders           Order[]

  @@map("exhibitions")
}

model ExhibitionProduct {
  id            String     @id @default(cuid())
  exhibitionId  String
  productId     String
  quantityTaken Int
  quantitySold  Int        @default(0)
  exhibition    Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id])

  @@unique([exhibitionId, productId])
  @@map("exhibition_products")
}

model StoreSetting {
  id                        String        @id @default(cuid())
  storeName                 String        @default("LittleWorks Inc")
  tagline                   String?
  logo                      String?
  favicon                   String?
  primaryColor              String        @default("#000000")
  secondaryColor            String        @default("#ffffff")
  accentColor               String        @default("#f59e0b")
  email                     String?
  phone                     String?
  address                   Json?
  instagram                 String?
  facebook                  String?
  pinterest                 String?
  twitter                   String?
  aiProvider                String?
  aiApiKey                  String?
  aiModel                   String?
  currency                  String        @default("USD")
  timezone                  String        @default("America/New_York")
  defaultShippingZoneId     String?
  // ✅ ENHANCED: Return Policy Fields with No Returns Option
  returnsEnabled            Boolean?      @default(true)
  returnPeriodDays          Int?          @default(30)
  returnPolicyUrl           String?
  hasRestockingFee          Boolean?      @default(false)
  restockingFeePercentage   Float?        @default(0)
  returnPolicyDescription   String?
  noReturnsReason           String?
  // ✅ END: Enhanced Return Policy Fields
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  defaultShippingZone       ShippingZone? @relation(fields: [defaultShippingZoneId], references: [id])

  @@map("store_settings")
}

// Shipping Zone Model (groups countries/regions)
model ShippingZone {
  id              String         @id @default(cuid())
  name            String         @unique
  description     String?
  isDefault       Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  zoneCountries   CountryShippingZone[]
  shippingRates   ShippingRate[]
  storeSettings   StoreSetting[]

  @@map("shipping_zones")
}

model CountryShippingZone {
  id              String       @id @default(cuid())
  countryId       String
  shippingZoneId  String
  createdAt       DateTime     @default(now())
  country         Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  shippingZone    ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@unique([countryId, shippingZoneId])
  @@map("country_shipping_zones")
}

// Shipping Rate Model (pricing rules per zone)
model ShippingRate {
  id                    String       @id @default(cuid())
  shippingZoneId        String
  name                  String
  description           String?
  flatRate              Float
  freeShippingThreshold Float?
  estimatedDays         String?
  maxWeightKg           Float?
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  shippingZone          ShippingZone @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@map("shipping_rates")
}