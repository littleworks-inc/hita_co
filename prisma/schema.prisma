generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String
  role           UserRole  @default(ADMIN)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users")
}

model StoreSettings {
  id                        String   @id @default(cuid())
  storeName                 String   @default("Hita&Co")
  tagline                   String?
  description               String?
  logo                      String?
  favicon                   String?
  primaryColor              String   @default("#1f2937")
  secondaryColor            String   @default("#f3f4f6")
  accentColor               String   @default("#f59e0b")
  email                     String?
  phone                     String?
  address                   String?
  socialMedia               Json?
  businessHours             Json?
  currency                  String   @default("USD")
  timezone                  String   @default("America/New_York")
  taxRate                   Float    @default(0)
  shippingRates             Json?
  paymentMethods            Json?
  returnsPolicy             String?
  privacyPolicy             String?
  termsOfService            String?
  metaTitle                 String?
  metaDescription           String?
  googleAnalyticsId         String?
  facebookPixelId           String?
  isMaintenanceMode         Boolean  @default(false)
  disableShoppingCart       Boolean? @default(false)
  catalogModeSettings       String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("store_settings")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  lastUpdated  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
  @@map("exchange_rates")
}

model Country {
  id             String    @id @default(cuid())
  name           String    @unique
  code           String    @unique
  currency       String
  currencySymbol String
  exchangeRate   Float?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@map("countries")
}

model Supplier {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  contactPerson String?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]

  @@map("suppliers")
}

model Category {
  id                   String    @id @default(cuid())
  name                 String    @unique
  description          String?
  slug                 String    @unique
  image                String?
  isActive             Boolean   @default(true)
  sortOrder            Int       @default(0)
  defaultRequiresSizes Boolean   @default(false)
  defaultSizeType      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  products             Product[]

  @@map("categories")
}

model Product {
  id                      String               @id @default(cuid())
  name                    String
  description             String?
  shortDescription        String?
  sku                     String               @unique
  images                  String[]
  originalPrice           Float
  originalCurrency        String               @default("USD")
  quantity                Int                  @default(0)
  gstPercentage           Float                @default(0)
  shippingCost            Float                @default(0)
  conversionCharges       Float                @default(0)
  additionalExpenses      Float                @default(0)
  costPriceUSD            Float
  piecePriceUSD           Float
  profitMargin            Float                @default(0)
  discountPercentage      Float                @default(0)
  sellingPriceUSD         Float
  stockQuantity           Int                  @default(0)
  lowStockAlert           Int                  @default(5)
  categoryId              String
  countryId               String
  supplierId              String
  weight                  Float?
  dimensions              Json?
  material                String?
  careInstructions        String?
  tags                    String[]
  isFeatured              Boolean              @default(false)
  isActive                Boolean              @default(true)
  slug                    String?              @unique
  metaTitle               String?
  metaDescription         String?
  barcode                 String?              @unique
  barcodeType             String?              @default("CODE128")
  publishedAt             DateTime?
  status                  ProductStatus        @default(DRAFT)
  archivedAt              DateTime?
  showDiscountToCustomers Boolean              @default(false)
  requiresSizes           Boolean              @default(false)
  sizeType                String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  cartItems               CartItem[]
  exhibitionItems         ExhibitionProduct[]
  exhibitionSaleItems     ExhibitionSaleItem[]
  orderItems              OrderItem[]
  productSizes            ProductSize[]
  category                Category             @relation(fields: [categoryId], references: [id])
  country                 Country              @relation(fields: [countryId], references: [id])
  supplier                Supplier             @relation(fields: [supplierId], references: [id])

  @@map("products")
}

model ProductSize {
  id                  String                  @id @default(cuid())
  productId           String
  size                String
  sku                 String                  @unique
  stockQuantity       Int                     @default(0)
  lowStockAlert       Int                     @default(5)
  isActive            Boolean                 @default(true)
  sortOrder           Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  cartItems           CartItem[]
  exhibitionSizes     ExhibitionProductSize[]
  exhibitionSaleItems ExhibitionSaleItem[]
  orderItems          OrderItem[]
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_sizes")
}

model ExhibitionProductSize {
  id                  String            @id @default(cuid())
  exhibitionProductId String
  productSizeId       String
  quantityTaken       Int               @default(0)
  quantitySold        Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  exhibitionProduct   ExhibitionProduct @relation(fields: [exhibitionProductId], references: [id], onDelete: Cascade)
  productSize         ProductSize       @relation(fields: [productSizeId], references: [id], onDelete: Cascade)

  @@unique([exhibitionProductId, productSizeId])
  @@map("exhibition_product_sizes")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress Json
  subtotal        Float
  tax             Float         @default(0)
  shipping        Float         @default(0)
  discount        Float         @default(0)
  total           Float
  currency        String        @default("USD")
  source          OrderSource   @default(ONLINE)
  locationNote    String?
  exhibitionId    String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?
  status          OrderStatus   @default(PENDING)
  notes           String?
  trackingNumber  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  exhibition      Exhibition?   @relation(fields: [exhibitionId], references: [id])

  @@map("orders")
}

model OrderItem {
  id            String       @id @default(cuid())
  orderId       String
  productId     String
  productSizeId String?
  sizeLabel     String?
  quantity      Int
  unitPrice     Float
  totalPrice    Float
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id])
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])

  @@map("order_items")
}

model CartItem {
  id            String       @id @default(cuid())
  sessionId     String
  userId        String?
  productId     String
  productSizeId String?
  quantity      Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])

  @@unique([sessionId, productId, productSizeId])
  @@map("cart_items")
}

model Exhibition {
  id               String              @id @default(cuid())
  title            String
  description      String?
  location         String
  startDate        DateTime
  endDate          DateTime
  participationFee Float               @default(0)
  images           String[]
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  products         ExhibitionProduct[]
  sales            ExhibitionSale[]
  orders           Order[]

  @@map("exhibitions")
}

model ExhibitionProduct {
  id                 String                  @id @default(cuid())
  exhibitionId       String
  productId          String
  quantityTaken      Int
  quantitySold       Int                     @default(0)
  exhibitionPrice    Float?
  originalPrice      Float?
  discountPercentage Float?                  @default(0)
  isClearance        Boolean                 @default(false)
  priceHistory       Json?
  salesNotes         String?
  lastSaleDate       DateTime?
  priceChangedAt     DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  exhibitionSizes    ExhibitionProductSize[]
  exhibition         Exhibition              @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  product            Product                 @relation(fields: [productId], references: [id])
  saleItems          ExhibitionSaleItem[]

  @@unique([exhibitionId, productId])
  @@map("exhibition_products")
}

model ExhibitionSale {
  id               String                  @id @default(cuid())
  exhibitionId     String
  saleNumber       String                  @unique
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  subtotal         Float
  customDiscount   Float                   @default(0)
  bundleDiscount   Float                   @default(0)
  finalTotal       Float
  paymentMethod    ExhibitionPaymentMethod
  cashAmount       Float?
  zelleAmount      Float?
  cardAmount       Float?
  paymentNotes     String?
  bargainApplied   Boolean                 @default(false)
  bargainReason    String?
  salesPersonNotes String?
  isCompleted      Boolean                 @default(false)
  completedAt      DateTime?
  receiptPrinted   Boolean                 @default(false)
  receiptEmailSent Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  items            ExhibitionSaleItem[]
  exhibition       Exhibition              @relation(fields: [exhibitionId], references: [id])

  @@map("exhibition_sales")
}

model ExhibitionSaleItem {
  id                  String            @id @default(cuid())
  saleId              String
  exhibitionProductId String
  productId           String
  productSizeId       String?
  sizeLabel           String?
  productName         String
  productSku          String
  categoryName        String
  originalPrice       Float
  exhibitionPrice     Float
  finalPrice          Float
  quantity            Int
  lineTotal           Float
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  exhibitionProduct   ExhibitionProduct @relation(fields: [exhibitionProductId], references: [id])
  product             Product           @relation(fields: [productId], references: [id])
  productSize         ProductSize?      @relation(fields: [productSizeId], references: [id])
  sale                ExhibitionSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("exhibition_sale_items")
}

enum UserRole {
  ADMIN
  STAFF
  MANAGER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderSource {
  ONLINE
  EXHIBITION
  PHONE
  EMAIL
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  STRIPE
  BANK_TRANSFER
  CASH_ON_DELIVERY
  ZELLE
  VENMO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum ExhibitionPaymentMethod {
  CASH
  ZELLE
  CARD
  VENMO
  PAYPAL
  SPLIT_PAYMENT
}
